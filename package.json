{
  "name": "dibs",
  "version": "0.1.0",
  "private": true,
  "description": "Coordination for many coding agents on one git repo: claim paths before editing, verdict-gated merge. Built on Cloudflare Workers and Artifacts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm build:board && wrangler deploy",
    "deploy:first": "pnpm build:board && wrangler deploy --secrets-file .dev.vars",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p board",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "node test/local/run.ts --e2e",
    "local": "node test/local/run.ts",
    "dev:board": "vite --config board/vite.config.ts",
    "build:board": "vite build --config board/vite.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@fontsource-variable/recursive": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.25.0",
    "diff": "^9.0.0",
    "zod": "^4.6.5"
  }
}
